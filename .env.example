# =============================================================================
# AlphaInk Newsletter Suite — variabili d'ambiente
# Copia questo file in .env.local (web) e configura i secret delle Functions
# con: firebase functions:secrets:set NOME_SECRET
# =============================================================================

# --- Firebase (client, pubbliche) -------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=alphaink-newsletter.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=alphaink-newsletter
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=alphaink-newsletter.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Regione delle Cloud Functions (deve combaciare con functions/src/lib/config.ts)
NEXT_PUBLIC_FUNCTIONS_REGION=europe-west1

# Usa gli emulatori Firebase in sviluppo locale
NEXT_PUBLIC_USE_EMULATORS=false

# --- Firebase Admin (server, Next.js API routes) ----------------------------
# In App Hosting / Cloud Run le credenziali sono automatiche (ADC).
# In locale punta a un service account JSON:
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
FIREBASE_PROJECT_ID=alphaink-newsletter

# --- Brevo ------------------------------------------------------------------
# Secret lato Functions:  firebase functions:secrets:set BREVO_API_KEY
BREVO_API_KEY=
BREVO_WEBHOOK_SECRET=
BREVO_SENDER_NAME=AlphaInk
BREVO_SENDER_EMAIL=newsletter@alphaink.net
BREVO_REPLY_TO=info@alphaink.net

# --- Sito AlphaInk: OpenCart (B2C, alphaink.net/store) ----------------------
OPENCART_BASE_URL=https://alphaink.net/store
OPENCART_API_MODE=rest            # rest | mysql
OPENCART_API_KEY=
OPENCART_API_USERNAME=
# Connessione MySQL read-only (alternativa a REST)
OPENCART_DB_HOST=
OPENCART_DB_PORT=3306
OPENCART_DB_USER=
OPENCART_DB_PASSWORD=
OPENCART_DB_NAME=
OPENCART_DB_PREFIX=oc_

# --- Sito AlphaInk: PrestaShop (B2B, b2b.alphaink.net) ----------------------
PRESTASHOP_BASE_URL=https://b2b.alphaink.net
PRESTASHOP_WS_KEY=

# --- Webhook in ingresso dal sito ------------------------------------------
SITE_WEBHOOK_SECRET=

# --- Tracking / attribuzione ------------------------------------------------
# Dominio usato per i link tracciati e i pixel
NEXT_PUBLIC_APP_URL=https://newsletter.alphaink.net
ATTRIBUTION_WINDOW_DAYS=7
